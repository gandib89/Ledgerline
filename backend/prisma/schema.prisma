// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  memberships Membership[]
  refreshTokens RefreshToken[]
  
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  memberships Membership[]
  accounts    Account[]
  taxCodes    TaxCode[]
  fiscalYears FiscalYear[]
  journalEntries JournalEntry[]
  journalLines    JournalLine[]
  auditLogs       AuditLog[]
  idempotencyKeys IdempotencyKey[]
  parties Party[]
  documents       Document[]
  documentSeries  DocumentSeries[]
  entrySeries     EntrySeries[]
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  roleId         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
}


model Role {
  id   String @id @default(uuid())
  name String @unique

  rolePermissions RolePermission[]
  memberships     Membership[]
}

model Permission {
  id   String @id @default(uuid())
  code String @unique

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@unique([roleId, permissionId])
}
model FiscalYear {
  id             String   @id @default(uuid())
  organizationId String
  label          String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean  @default(false)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  periods      AccountingPeriod[]
  documents      Document[]
  documentSeries DocumentSeries[]
  entrySeries    EntrySeries[]

  @@unique([organizationId, label])
}

model AccountingPeriod {
  id           String   @id @default(uuid())
  fiscalYearId String
  label        String
  startDate    DateTime
  endDate      DateTime
  isOpen       Boolean  @default(true)

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]
  @@unique([fiscalYearId, label])
}
enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum DocType {
  INVOICE
  CREDIT_NOTE
  RECEIPT
  BILL
  SUPPLIER_PAYMENT
}

enum DocStatus {
  DRAFT
  POSTED
  PARTIALLY_PAID
  PAID
  REVERSED
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model Account {
  id               String      @id @default(uuid())
  organizationId   String
  code             String
  name             String
  type             AccountType
  isControlAccount Boolean     @default(false)
  isBankAccount    Boolean     @default(false)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  journalLines JournalLine[]
  documentLines DocumentLine[]
  taxCodesAsOutput TaxCode[] @relation("TaxCodeOutputAccount")
  taxCodesAsInput  TaxCode[] @relation("TaxCodeInputAccount")

  @@unique([organizationId, code])
  @@index([organizationId, type])
}
enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

model Party {
  id             String    @id @default(uuid())
  organizationId String
  type           PartyType
  code           String
  name           String
  panVatNo       String?
  email          String?
  phone          String?
  address        String?
  creditDays     Int       @default(30)
  creditLimit    Decimal?  @db.Decimal(18, 4)
  isActive       Boolean   @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  documents    Document[]
  journalLines JournalLine[]

  @@unique([organizationId, code])
}

enum TaxCodeType {
  VAT
  EXEMPT
  ZERO
}

model TaxCode {
  id              String      @id @default(uuid())
  organizationId  String
  code            String
  name            String
  rate            Decimal     @db.Decimal(5, 4)
  type            TaxCodeType @default(VAT)
  outputAccountId String?
  inputAccountId  String?
  isActive        Boolean     @default(true)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  outputAccount Account?       @relation("TaxCodeOutputAccount", fields: [outputAccountId], references: [id], onDelete: Restrict)
  inputAccount  Account?       @relation("TaxCodeInputAccount", fields: [inputAccountId], references: [id], onDelete: Restrict)
  documentLines DocumentLine[]

  @@unique([organizationId, code])
}

model JournalEntry {
  id             String      @id @default(uuid())
  organizationId String
  periodId       String
  entryNumber    String
  documentType   String
  entryDate      DateTime
  description    String?
  status         EntryStatus @default(DRAFT)
  sourceId       String?
  postedAt       DateTime?
  postedById     String?
  createdAt      DateTime    @default(now())

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  period       AccountingPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  lines        JournalLine[]
  sourceDocument Document?

  @@unique([organizationId, entryNumber])
  @@index([organizationId, entryDate, status])
}

model JournalLine {
  id             String  @id @default(uuid())
  journalEntryId String
  organizationId String
  accountId      String
  partyId        String?
  debit          Decimal @db.Decimal(18, 4)
  credit         Decimal @db.Decimal(18, 4)
  description    String?
  lineNumber     Int

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  party        Party?       @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([organizationId, accountId])
  @@index([organizationId, partyId])
}
model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
}

model IdempotencyKey {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  endpoint       String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
}

model DocumentSeries {
  id             String  @id @default(uuid())
  organizationId String
  docType        DocType
  fiscalYearId   String
  prefix         String
  padding        Int     @default(4)
  nextNumber     Int     @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([organizationId, docType, fiscalYearId])
}

// journal_entries.entry_no is one shared sequence per (org, fiscal year)
// across every source type — invoice-, receipt- and manual-sourced entries
// interleave in the same JE-#### series (§6 worked examples). doc_no above
// is per doc_type instead, which is why it needs its own table.
model EntrySeries {
  id             String @id @default(uuid())
  organizationId String
  fiscalYearId   String
  prefix         String @default("JE")
  padding        Int    @default(4)
  nextNumber     Int    @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear   FiscalYear   @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  @@unique([organizationId, fiscalYearId])
}

model Document {
  id             String    @id @default(uuid())
  organizationId String
  fiscalYearId   String
  docType        DocType
  docNo          String?
  docDate        DateTime  @db.Date
  dueDate        DateTime? @db.Date
  partyId        String?

  subtotal          Decimal @default(0) @db.Decimal(18, 4)
  discountAmount    Decimal @default(0) @db.Decimal(18, 4)
  taxableAmount     Decimal @default(0) @db.Decimal(18, 4)
  taxAmount         Decimal @default(0) @db.Decimal(18, 4)
  grandTotal        Decimal @default(0) @db.Decimal(18, 4)
  allocatedAmount   Decimal @default(0) @db.Decimal(18, 4)
  outstandingAmount Decimal @default(0) @db.Decimal(18, 4)

  status           DocStatus @default(DRAFT)
  parentDocumentId String?
  referenceNo      String?
  notes            String?
  journalEntryId   String?   @unique
  postedAt         DateTime?
  postedById       String?
  createdById      String?
  version          Int       @default(0)
  createdAt        DateTime  @default(now())

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  party          Party?         @relation(fields: [partyId], references: [id], onDelete: Restrict)
  parentDocument Document?      @relation("DocumentCorrection", fields: [parentDocumentId], references: [id], onDelete: Restrict)
  corrections    Document[]     @relation("DocumentCorrection")
  journalEntry   JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  lines          DocumentLine[]

  @@unique([organizationId, docType, fiscalYearId, docNo])
  @@index([organizationId, docType, docDate])
  @@index([organizationId, partyId])
}

model DocumentLine {
  id            String  @id @default(uuid())
  documentId    String
  lineNo        Int
  description   String
  accountId     String
  quantity      Decimal @db.Decimal(18, 6)
  unitPrice     Decimal @db.Decimal(18, 4)
  discountPct   Decimal @default(0) @db.Decimal(5, 2)
  taxableAmount Decimal @db.Decimal(18, 4)
  taxCodeId     String?
  taxAmount     Decimal @default(0) @db.Decimal(18, 4)
  lineTotal     Decimal @db.Decimal(18, 4)

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  taxCode  TaxCode? @relation(fields: [taxCodeId], references: [id], onDelete: Restrict)

  @@unique([documentId, lineNo])
}
